# From https://dashboard.privy.io — App settings
# App ID only (required for web)
EXPO_PUBLIC_PRIVY_APP_ID=

# Required for claim proof uploads (image + metadata pinned via Pinata).
# Use HTTPS gateway URLs on-chain so poidh.xyz can resolve claim images.
EXPO_PUBLIC_PINATA_JWT=

# Optional RPC overrides for native balance reads (defaults to public endpoints)
# EXPO_PUBLIC_RPC_1=
# EXPO_PUBLIC_RPC_42161=
# EXPO_PUBLIC_RPC_8453=
# EXPO_PUBLIC_RPC_666666666=
