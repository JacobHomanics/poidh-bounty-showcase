# From https://dashboard.privy.io — App settings
# App ID only (required for web)
EXPO_PUBLIC_PRIVY_APP_ID=

# Required for durable claim proofs (poidh.xyz parity: image + metadata on IPFS)
EXPO_PUBLIC_PINATA_JWT=

